# Copy this file to src/backend/.env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai (REQUIRED for AI features) ────────────────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Default: local MongoDB instance
# Change to your MongoDB Atlas connection string for cloud deployment
MONGO_URI=mongodb://127.0.0.1:27017/bob-logistics-hackathon

# ── Application ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Notes ─────────────────────────────────────────────────────────────────────
# If WATSONX_API_KEY is invalid or missing, the app uses grounded fallback
# responses for all AI calls. All deterministic engines (risk scoring,
# fleet matching, route optimization, cold-chain detection) work independently.
